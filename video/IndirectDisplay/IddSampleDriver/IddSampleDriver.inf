;
; IddSampleDriver.inf - Fixed Version
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=IddSampleDriver.cat
DriverVer=10/27/2025,1.0.0.0

[Manufacturer]
%ManufacturerName%=Standard, NTamd64.10.0...19041, NTamd64.10.0...22000

[Standard.NTamd64.10.0...19041]
%DeviceName% = MyDevice_Install_Win10, Root\IddSampleDriver
%DeviceName%=MyDevice_Install_Win10, IddSampleDriver

[Standard.NTamd64.10.0...22000]
%DeviceName%=MyDevice_Install, Root\IddSampleDriver
%DeviceName%=MyDevice_Install, IddSampleDriver

[SourceDisksFiles]
IddSampleDriver.dll=1
IndirectKmd.sys=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

;---------------- copy files

[MyDevice_Install_Win10.NT]
CopyFiles=UMDriverCopy
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[MyDevice_Install_Win10.NT.hw]
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_HardwareDeviceSettings]
HKR,, UpperFilters, %REG_MULTI_SZ%, IndirectKmd
HKR, WUDF, DeviceGroupId, %REG_SZ%, IddSampleDriverGroup

;---------------- service installation

[MyDevice_Install_Win10.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall
AddService=IndirectKmd,,IndirectKmd_ServiceInstall

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys

[IndirectKmd_ServiceInstall]
DisplayName = %IndirectKmdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\IndirectKmd.sys

[MyDevice_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall
AddService=IndirectKmd,,IndirectKmd_ServiceInstall

[MyDevice_Install_Win10.NT.Wdf]
KmdfService = IndirectKmd, IndirectKmd_wdfsect

[MyDevice_Install.NT.Wdf]
KmdfService = IndirectKmd, IndirectKmd_wdfsect

[IndirectKmd_wdfsect]
KmdfLibraryVersion = 1.15

[DestinationDirs]
UMDriverCopy = 12

[UMDriverCopy]
IddSampleDriver.dll

[Strings]
ManufacturerName = VDD SDK Project
DeviceName = IddSampleDriver Device
DiskName = IddSampleDriver Installation Disk
WudfRdDisplayName = Windows Driver Foundation - User-mode Driver Framework Reflector
IndirectKmdDisplayName = IndirectKmd
REG_SZ = 0x00000000
REG_MULTI_SZ = 0x00010000



